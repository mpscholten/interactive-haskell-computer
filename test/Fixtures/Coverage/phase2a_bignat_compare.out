compare 10 5  = GT
compare 5  5  = EQ
compare 5  10 = LT
eq#  5  5     = True
eq#  5  10    = False
ne#  5  5     = False
ne#  5  10    = True
lt#  5  10    = True
lt#  10 5     = False
le#  5  5     = True
le#  10 5     = False
gt#  10 5     = True
gt#  5  5     = False
ge#  5  5     = True
ge#  5  10    = False
isZero# 0     = True
isZero# 5     = False
isOne#  1     = True
isOne#  0     = False
size#   0     = 0
size#   5     = 1
