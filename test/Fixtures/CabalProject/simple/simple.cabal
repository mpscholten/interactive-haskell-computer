cabal-version:      3.0
name:               simple
version:            0.1.0.0
synopsis:           Phase 2.7 loader test fixture
license:            BSD-3-Clause
build-type:         Simple

library
    exposed-modules:  Local
    hs-source-dirs:   lib
    default-extensions:
        OverloadedStrings
      , LambdaCase
    cpp-options:      -DFIXTURE_FLAG=1
    default-language: Haskell2010
    build-depends:    base

executable simple-app
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: Haskell2010
    build-depends:    base, simple
