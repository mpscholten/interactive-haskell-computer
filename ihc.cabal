cabal-version:      3.0
name:               ihc
version:            0.1.0.0
synopsis:           Interactive Haskell Computer — demand-driven copy-and-patch JIT interpreter
description:        Single-pass, Pascal-style, demand-driven Haskell interpreter targeting macOS/aarch64.
author:             digitally induced
maintainer:         marc@digitallyinduced.com
license:            MIT
build-type:         Simple
tested-with:        GHC == 9.10.*

common warnings
    ghc-options:      -Wall -Wno-unused-imports -Wno-unused-matches -Wno-name-shadowing -Werror=incomplete-patterns

common lang
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
      , LambdaCase
      , BangPatterns
      , ScopedTypeVariables
      , RecordWildCards
      , BlockArguments
      , DerivingStrategies
      , StrictData
      , RecursiveDo

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        IHC
      , IHC.AST
      , IHC.Builtins
      , IHC.CabalProject
      , IHC.Classes
      , IHC.Core
      , IHC.Cpp
      , IHC.Diagnostics
      , IHC.Driver
      , IHC.Elaborate
      , IHC.Eval
      , IHC.EvalCore
      , IHC.FFI
      , IHC.InstanceManifest
      , IHC.Lexer
      , IHC.Lower
      , IHC.ModuleHeader
      , IHC.PackageStore
      , IHC.Parser
      , IHC.Repl
      , IHC.Scan
      , IHC.Scheduler
      , IHC.Source
      , IHC.TH
      , IHC.TypeAST
      , IHC.TypeDescribe
      , IHC.TypeGlobals
      , IHC.TypeReduce
      , IHC.TypeUnify
      , IHC.Val
      -- Dormant Phase-1 JIT machinery, kept in tree but no longer
      -- on the runtime path. May be re-activated as a tier-2 opt JIT
      -- once the interpreter supports the full language.
      , IHC.CodeBuffer
      , IHC.Emit
      , IHC.Encode
      , IHC.IR
      , IHC.Jit
      , IHC.Stdlib
    build-depends:
        base             >= 4.19 && < 5
      , bytestring       >= 0.11
      , Cabal-syntax     >= 3.8
      , containers       >= 0.6
      , directory        >= 1.3
      , filepath         >= 1.4
      , hashable         >= 1.4
      , haskeline        >= 0.8
      , libffi           >= 0.2
      , process          >= 1.6
      , stm              >= 2.5
      , text             >= 2.0
      , time             >= 1.12
      , unix             >= 2.8
      , unordered-containers >= 0.2

    c-sources:
        rts/jit.c
      , rts/bridge.c
    -- rts/enter.S will be added once it has real content.
    include-dirs:
        rts
    install-includes:
        jit.h

    cc-options:
        -Wall
        -Wextra
        -fno-stack-protector
        -mmacosx-version-min=14.0

    -- Interpreter inner loops (env lookup, thunk forcing, class dispatch)
    -- run millions of times during warp-style programs. -O2 unlocks
    -- enough inlining + specialisation in those hot paths to make the
    -- difference between "minutes per request" and "fast enough".
    ghc-options:      -O2

executable ihc
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base
      , bytestring
      , filepath
      , ihc
      , text
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G" -O2

    -- Post-build codesigning must be handled outside cabal (see Makefile /
    -- scripts/codesign-jit.sh). cabal does not have a portable post-build hook.

executable ihc-parse-probe
    import:           warnings, lang
    hs-source-dirs:   probe
    main-is:          ParseProbe.hs
    build-depends:
        base
      , bytestring
      , containers
      , directory
      , filepath
      , ihc
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G"

executable probe-hsx
    import:           warnings, lang
    hs-source-dirs:   probe
    main-is:          HsxProbe.hs
    build-depends:
        base
      , bytestring
      , ihc
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G"

test-suite ihc-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        CabalLoader
      , CoreLowerTest
      , Coverage
      , HsExtTypeFams
      , HsExtMisc
      , HsExtRecords
      , Hs2010LexNum
      , HsExtTypeApps
      , HsExtForall
      , Hs2010Fixity
      , Hs2010Deriving
      , HsExtDeriving
      , HsExtSyntax
      , HsExtClasses
      , HsExtKinds
      , HsExtPatterns
      , Hs2010ClassInst
      , Hs2010Types
      , HsExtGADTs
      , Hs2010Patterns
      , Hs2010LexIdent
      , Hs2010Bindings
      , Hs2010LexComments
      , HsExtLiterals
      , Hs2010ExprCtl
      , Hs2010Modules
      , Hs2010LexStr
      , Hs2010ExprData
      , Hs2010LexLayout
      , Hs2010DataDecl
      , JitSmoke
      , LexerIhp
      , NorthStarTest
      , ParserBugs
      , ReplTest
      , RunFile
      , Unsupported
    build-depends:
        base
      , ihc
      , bytestring
      , containers
      , directory
      , filepath
      , hspec            >= 2.10
      , process          >= 1.6
    -- Tests run sequentially under hspec.  Pin the RTS to a single
    -- capability so parallel GC doesn't spin on every core while the
    -- actual workload is single-threaded.  The user-facing interpreter
    -- binary (exe:ihc) still gets -N.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -M4G"
