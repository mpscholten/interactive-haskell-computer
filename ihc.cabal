cabal-version:      3.0
name:               ihc
version:            0.1.0.0
synopsis:           Interactive Haskell Computer — demand-driven copy-and-patch JIT interpreter
description:        Single-pass, Pascal-style, demand-driven Haskell interpreter targeting macOS/aarch64.
author:             digitally induced
maintainer:         marc@digitallyinduced.com
license:            MIT
build-type:         Simple
tested-with:        GHC == 9.10.*

common warnings
    ghc-options:      -Wall -Wno-unused-matches -Wno-name-shadowing -Werror=incomplete-patterns -Werror=incomplete-uni-patterns -Werror=incomplete-record-updates -Werror=missing-fields -Werror=missing-methods -Werror=unused-binds -Werror=unused-imports

common lang
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
      , LambdaCase
      , BangPatterns
      , ScopedTypeVariables
      , RecordWildCards
      , BlockArguments
      , DerivingStrategies
      , StrictData
      , RecursiveDo

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        IHC
      , IHC.AST
      , IHC.Builtins
      , IHC.CabalProject
      , IHC.Classes
      , IHC.Context
      , IHC.Core
      , IHC.Cpp
      , IHC.Diagnostics
      , IHC.Driver
      , IHC.Elaborate
      , IHC.Eval
      , IHC.EvalCore
      , IHC.FFI
      , IHC.InstanceManifest
      , IHC.Lexer
      , IHC.Loader.Types
      , IHC.Lower
      , IHC.MemDebug
      , IHC.ModuleHeader
      , IHC.PackageStore
      , IHC.Parser
      , IHC.PatSyn
      , IHC.Pretty
      , IHC.Repl
      , IHC.Scan
      , IHC.Scheduler
      , IHC.Source
      , IHC.StringUtils
      , IHC.TH
      , IHC.TypeAST
      , IHC.TypeDescribe
      , IHC.TypeGlobals
      , IHC.TypeReduce
      , IHC.TypeUnify
      , IHC.Val
    build-depends:
        base             >= 4.19 && < 5
      , bytestring       >= 0.11
      , Cabal-syntax     >= 3.8
      , containers       >= 0.6
      , directory        >= 1.3
      , filepath         >= 1.4
      , hashable         >= 1.4
      , haskeline        >= 0.8
      , libffi           >= 0.2
      , process          >= 1.6
      , stm              >= 2.5
      , text             >= 2.0
      , time             >= 1.12
      , unix             >= 2.8
      , unordered-containers >= 0.2

    -- Interpreter inner loops (env lookup, thunk forcing, class dispatch)
    -- run millions of times during warp-style programs. -O2 unlocks
    -- enough inlining + specialisation in those hot paths to make the
    -- difference between "minutes per request" and "fast enough".
    ghc-options:      -O2

executable ihc
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base
      , bytestring
      , filepath
      , ihc
      , text
    -- -rdynamic exports the executable's own symbols (including the
    -- statically-linked GHC RTS) into the dynamic symbol table, so that
    -- interpreted FFI imports of RTS-exclusive symbols (rtsSupportsBoundThreads,
    -- getNumberOfProcessors, getMonotonicNSec, getOrSet* stores, …) resolve via
    -- IHC.FFI.resolveSymbol's dlsym(RTLD_DEFAULT) fallback. These have no
    -- Haskell source and live only in the RTS; this is the same RTS-exclusive
    -- carve-out as the VIO/State# bridges (see CLAUDE.md). Portable: GHC maps
    -- -rdynamic to --export-dynamic (ELF) / -export_dynamic (mach-o).
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G" -O2 -rdynamic

executable ihc-parse-probe
    import:           warnings, lang
    hs-source-dirs:   probe
    main-is:          ParseProbe.hs
    build-depends:
        base
      , bytestring
      , containers
      , directory
      , filepath
      , ihc
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G"

executable probe-hsx
    import:           warnings, lang
    hs-source-dirs:   probe
    main-is:          HsxProbe.hs
    build-depends:
        base
      , bytestring
      , ihc
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -M4G"

-- Isolated cross-fixture memory probe (Step-2 diagnosis + Step-4
-- plateau gate for the master-CI OOM fix).  RTS opts mirror the
-- 'ihc-test' test-suite stanza (-N1 -M8G -T) so the measurement
-- reproduces CI's heap regime; -T enables 'GHC.Stats.getRTSStats'
-- for the IHC_MEM_DEBUG [ihc:mem] dumps.  See probe/MemProbe.hs.
executable ihc-mem-probe
    import:           warnings, lang
    hs-source-dirs:   probe
    main-is:          MemProbe.hs
    build-depends:
        base
      , directory
      , filepath
      , ihc
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -M8G -T"

test-suite ihc-test
    import:           warnings, lang
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        CabalLoader
      , CoreLowerTest
      , Coverage
      , Properties.DoDesugar
      , Properties.Generators
      , Properties.RoundTrip
      , Properties.SectionDesugar
      , Properties.StringDesugar
      , Properties.Totality
      , Properties.TupleSectionDesugar
      , HsExtTypeFams
      , HsExtMisc
      , IhcTestBinary
      , HsExtRecords
      , Hs2010LexNum
      , HsExtTypeApps
      , HsExtForall
      , Hs2010Fixity
      , Hs2010Deriving
      , HsExtDeriving
      , HsExtSyntax
      , HsExtClasses
      , HsExtKinds
      , HsExtPatterns
      , Hs2010ClassInst
      , Hs2010Types
      , HsExtGADTs
      , Hs2010Patterns
      , Hs2010LexIdent
      , Hs2010Bindings
      , Hs2010LexComments
      , HsExtLiterals
      , Hs2010ExprCtl
      , Hs2010Modules
      , Hs2010LexStr
      , Hs2010ExprData
      , Hs2010LexLayout
      , Hs2010DataDecl
      , LexerIhp
      , NorthStarTest
      , ParserBugs
      , ReplTest
      , RunFile
      , Unsupported
      , NetworkSocketAddrInfoRecordUpdateTest
      , TopLevelIOBindingTest
      , TopLevelWarpAliasTest
      , WarpHelloTest
      , WarpRunStartupTest
    build-depends:
        base
      , ihc
      , bytestring
      , containers
      , directory
      , filepath
      , hspec            >= 2.10
      , process          >= 1.6
      -- Spec.hs runs the suite as a re-exec'd child and
      -- 'System.Posix.Signals.signalProcess sigKILL's it once hspec's
      -- summary is read — a fixture leaves an unkillable masked thread
      -- that wedges GHC's RTS shutdown, so the child can't be relied on
      -- to exit itself (the suite-completes-then-hangs failure).
      , unix
      -- Property-based parser totality fuzz suite (Phase 1 of the
      -- "random Haskell programs" plan — see
      -- plans/can-we-convert-the-temporal-castle.md).
      , QuickCheck       >= 2.14
    build-tool-depends:
        ihc:ihc
    -- Tests run sequentially under hspec; -N1 pins a single capability
    -- so parallel GC doesn't spin every core on this single-threaded
    -- workload.  (The shutdown hang a leaked unkillable masked fixture
    -- thread causes is handled by Spec.hs's parent/child re-exec, not
    -- by adding capabilities.)
    --
    -- -M8G: this used to mask a real leak — interpreted programs
    -- forked background threads (warp accept loop, System.TimeManager,
    -- async, forkIO) that were never reaped, so their TSO stacks
    -- accumulated across the ~600-example in-process suite to ~4 GB of
    -- STACK and the run heap-exhausted (the prior "linux finalisation
    -- OOM").  That leak is fixed: 'IHC.Builtins.reapSpawnedThreads',
    -- wired into 'resetPerRunGlobals', kills the prior run's threads at
    -- each fixture boundary; a heap profile of the full suite now shows
    -- steady ~1.5 MB STACK instead of monotonic 4 GB growth.
    --
    -- The cap stays 8G (NOT lowered to 4G) because IHC_MEM_DEBUG
    -- measurement found a SEPARATE, pre-existing, non-accumulating
    -- transient: one heavy fixture momentarily peaks ~4.2 GB live
    -- (max_live_bytes), fully reclaimed afterwards (steady live set is
    -- ~100 MB).  That is a legitimate single-fixture working set, not
    -- the leak; -M4G would heap-exhaust on it.  8 GB is the smallest
    -- power-of-two with headroom over the measured 4.2 GB transient —
    -- now a justified ceiling, not leak-masking.  Shrinking the
    -- transient is separate, out-of-scope work.
    --
    -- -T: enable RTS stat collection so 'GHC.Stats.getRTSStats' works
    -- for the @IHC_MEM_DEBUG@ cross-fixture leak probe
    -- ('IHC.MemDebug.dumpMemStats').  -T only maintains counters (no
    -- extra GC); overhead is unmeasurable and it is inert unless the
    -- flag is set, so it is kept permanently.
    --
    -- -rdynamic: same rationale as executable ihc (PR #185).  CI runs
    -- this binary under nix with per-package cbits .so files dlopened
    -- RTLD_GLOBAL; ghc-internal's PrelIOUtils.c calls RTS errorBelch /
    -- debugBelch.  Without exporting the test binary's static RTS into
    -- the dynamic symbol table, Linux aborts mid-suite with
    -- "undefined symbol: errorBelch".
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1 -M8G -T" -rdynamic
